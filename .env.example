GITDOCK_ENV=development
GITDOCK_LOG_LEVEL=INFO
GITDOCK_DATABASE_URL=sqlite+aiosqlite:///./gitdock.db
GITDOCK_TELEGRAM_BOT_TOKEN=replace-me
GITDOCK_TELEGRAM_OWNER_ID=123456789
GITDOCK_PUBLIC_BASE_URL=
GITDOCK_TELEGRAM_WEBHOOK_SECRET=

# GitHub App authentication. Keep real values outside the repository.
GITDOCK_GITHUB_APP_ID=
GITDOCK_GITHUB_APP_SLUG=
GITDOCK_GITHUB_CLIENT_ID=
GITDOCK_GITHUB_CLIENT_SECRET=
GITDOCK_GITHUB_PRIVATE_KEY_PATH=
GITDOCK_GITHUB_WEBHOOK_SECRET=

# Authenticated encryption key for persisted credential/state material.
# Supply a valid Fernet key at deployment time; never commit the real key.
GITDOCK_CREDENTIAL_ENCRYPTION_KEY=
GITDOCK_CREDENTIAL_ENCRYPTION_KEY_VERSION=1
